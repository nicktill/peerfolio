# ---- Database -------------------------------------------------------------
# `docker compose up -d` from the repo root gives you exactly this URL.
# For hosted Postgres (Neon, Supabase), use the pooled connection string.
DATABASE_URL="postgresql://peerfolio:peerfolio@localhost:5433/peerfolio"

# ---- Encryption -----------------------------------------------------------
# Encrypts Plaid access tokens at rest. Generate with: openssl rand -hex 32
# Rotating this invalidates every stored connection, so keep it safe.
ENCRYPTION_KEY=""

# ---- Auth -----------------------------------------------------------------
# Must match the port you actually run on, or sign-in silently hangs on a
# session request that never resolves. Running on another port:
#   PORT=3200 npm run dev   ->   NEXTAUTH_URL="http://localhost:3200"
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# Sign in as a seeded user without setting up an OAuth app. Ignored entirely in
# production builds — see src/lib/auth.ts. Leave unset if you have real
# Google credentials below.
ENABLE_DEV_LOGIN="true"

# Only needed for real sign-in; the developer login above works without them.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---- Plaid ----------------------------------------------------------------
# "sandbox" until your production access request is approved.
PLAID_ENV="sandbox"
PLAID_CLIENT_ID=""
PLAID_SECRET=""
# Required for OAuth institutions (Chase, Schwab, Fidelity…); must be
# registered in the Plaid dashboard under Allowed redirect URIs. Points at the
# /oauth-return page, e.g. https://www.peerfolio.org/oauth-return
PLAID_REDIRECT_URI=""
# Public HTTPS URL of /api/plaid/webhook. Without it, items that fall out of
# auth go stale silently.
PLAID_WEBHOOK_URL=""

# ---- Cron -----------------------------------------------------------------
# Bearer token guarding /api/cron/snapshot. Generate with: openssl rand -hex 32
CRON_SECRET=""
