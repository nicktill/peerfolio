# ---- Database -------------------------------------------------------------
# Any Postgres. Neon and Supabase both work; use the pooled connection string.
DATABASE_URL="postgresql://user:password@host/peerfolio?sslmode=require"

# ---- Encryption -----------------------------------------------------------
# Encrypts Plaid access tokens at rest. Generate with: openssl rand -hex 32
# Rotating this invalidates every stored connection, so keep it safe.
ENCRYPTION_KEY=""

# ---- Auth -----------------------------------------------------------------
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---- Plaid ----------------------------------------------------------------
# "sandbox" until your production access request is approved.
PLAID_ENV="sandbox"
PLAID_CLIENT_ID=""
PLAID_SECRET=""
# Required for OAuth institutions; must be registered in the Plaid dashboard.
PLAID_REDIRECT_URI=""
# Public HTTPS URL of /api/plaid/webhook. Without it, items that fall out of
# auth go stale silently.
PLAID_WEBHOOK_URL=""

# ---- Cron -----------------------------------------------------------------
# Bearer token guarding /api/cron/snapshot. Generate with: openssl rand -hex 32
CRON_SECRET=""
