# ---- Database -------------------------------------------------------------
# `docker compose up -d` from the repo root gives you exactly this URL.
# For hosted Postgres (Neon, Supabase), use the pooled connection string.
DATABASE_URL="postgresql://peerfolio:peerfolio@localhost:5433/peerfolio"

# ---- Encryption -----------------------------------------------------------
# Encrypts Plaid access tokens at rest. Generate with: openssl rand -hex 32
# Rotating this invalidates every stored connection, so keep it safe.
ENCRYPTION_KEY=""

# ---- Auth -----------------------------------------------------------------
# Must match the port you actually run on, or sign-in silently hangs on a
# session request that never resolves. Running on another port:
#   PORT=3200 npm run dev   ->   NEXTAUTH_URL="http://localhost:3200"
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# Sign in as a seeded user without setting up an OAuth app. Ignored entirely in
# production — see src/lib/dev-login.ts. Leave unset if you have real
# Google credentials below.
ENABLE_DEV_LOGIN="true"
# Vercel *preview* deployments (set on the Preview environment, never Production): the login
# turns on only if DEV_LOGIN_DEMO_DATABASE=true, meaning that preview's database is disposable demo data.
# DEV_LOGIN_DEMO_DATABASE=true
# Optional: ask for a passcode (16+ characters), and/or limit which accounts it may open.
# DEV_LOGIN_SECRET=
# DEV_LOGIN_EMAILS=maya@example.com

# Only needed for real sign-in; the developer login above works without them.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---- Plaid ----------------------------------------------------------------
# "sandbox" until your production access request is approved.
PLAID_ENV="sandbox"
# Enable test-bank Link in local development. Keep off in public deployments.
ENABLE_PLAID_SANDBOX="false"
PLAID_CLIENT_ID=""
PLAID_SECRET=""
# Required for OAuth institutions (Chase, Schwab, Fidelity…); must be
# registered in the Plaid dashboard under Allowed redirect URIs. Points at the
# /oauth-return page, e.g. https://www.peerfolio.org/oauth-return
PLAID_REDIRECT_URI=""
# Public HTTPS URL of /api/plaid/webhook. Without it, items that fall out of
# auth go stale silently.
PLAID_WEBHOOK_URL=""

# ---- Market data ---------------------------------------------------------
# Prices manual positions each night (massive.com, formerly Polygon.io). Only
# needed once someone adds a position; the free plan is fine for local work,
# but showing prices to other people requires a Massive Business plan.
MASSIVE_API_KEY=""

# Live prices while the US market is open. Optional: without a key, prices are
# daily closes only. Finnhub's free plan (finnhub.io) allows 60 calls a minute
# but is for personal, non-commercial use; check its terms before a public
# launch. QUOTE_PROVIDER picks the source (finnhub, or "off"); swapping in
# another provider means adding one adapter, see src/lib/quote-provider.ts.
FINNHUB_API_KEY=""
QUOTE_PROVIDER="finnhub"
# Most tickers refreshed per minute across all servers (keep under the plan's limit).
LIVE_QUOTE_MAX_SYMBOLS="40"

# ---- News ------------------------------------------------------------------
# The nightly news job (/api/cron/news, scheduled in vercel.json) stores
# headlines from publishers' RSS feeds and asks OpenAI to write the daily and
# weekly recap from them only. Without a key, recaps are the top headlines.
# One recap costs roughly $0.003 on gpt-5-mini; the job stops calling the model
# for the rest of the month once NEWS_AI_MONTHLY_BUDGET_USD is reached.
OPENAI_API_KEY=""
NEWS_AI_MODEL="gpt-5-mini"
NEWS_AI_MONTHLY_BUDGET_USD="1"

# ---- Cron -----------------------------------------------------------------
# Bearer token guarding /api/cron/snapshot. Generate with: openssl rand -hex 32
CRON_SECRET=""
